# PikPak-backed persistent storage for hosts without a durable volume (for
# example the free Koyeb Web Service). Set BOTH values to enable it; leave them
# empty to use the normal /home/nanobot/.nanobot volume or disk instead.
#
# Do not commit real credentials here. Copy this file to .env (git-ignored) for
# local Compose runs, and inject the two variables as secrets on the platform.
PIKPAK_USER=
PIKPAK_PASSWORD=

# Optional tuning (defaults shown).
# PIKPAK_LOCAL_ROOT=/data/nanobot-home
# PIKPAK_REMOTE_PATH=nanobot/.nanobot
# PIKPAK_SYNC_INTERVAL=300
# PIKPAK_PULL_TIMEOUT=20
# PIKPAK_SYNC_LOOP=1
